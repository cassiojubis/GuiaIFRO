# Proteções do Guia IFRO (Apache). Cada pasta interna também tem o seu .htaccess.

# Não listar o conteúdo das pastas quando não houver index.
Options -Indexes

# Pastas e arquivos que nunca devem ser abertos pelo navegador:
# segredos, scripts de terminal, testes, banco, logs e o git.
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/(\.git|\.env|config|logs|sql|bin|tests|dados-privados)(/|$)
    RedirectMatch 404 (?i)\.(sql|log|env|ini|bak|sh)$
</IfModule>

<FilesMatch "(?i)^(\.env.*|\.git.*|\.htaccess|composer\.(json|lock)|.*\.sql|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# sitemap.xml e robots.txt são gerados pelo PHP (sitemap.php e robots.php),
# assim usam o domínio configurado e incluem todos os setores.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

