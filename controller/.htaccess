# Ninguém deve acessar estes arquivos direto pela URL — eles só devem ser
# carregados de dentro do próprio projeto (via require), nunca abertos
# diretamente no navegador.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
